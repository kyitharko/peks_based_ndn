FROM peks-base AS router

# ── NFD 22.12 with PeksStrategy injected ─────────────────────────
# NFD wscript uses ant_glob('daemon/**/*.cpp') so any .cpp we drop
# into daemon/fw/ is compiled automatically — no wscript source patch needed.
RUN git clone --depth=1 --branch NFD-22.12 --recursive \
    https://github.com/named-data/NFD.git /opt/NFD

# Inject all PEKS source/header files into NFD's fw directory.
# They will be picked up by ant_glob and compiled as part of daemon-objects.
COPY ndn/peks_strategy.hpp ndn/peks_strategy.cpp /opt/NFD/daemon/fw/
COPY ndn/peks_name.hpp ndn/peks_name.cpp          /opt/NFD/daemon/fw/
COPY ate_pairing.hpp ate_pairing.cpp               /opt/NFD/daemon/fw/
COPY peks.hpp peks.cpp                             /opt/NFD/daemon/fw/

# Fix three categories of broken includes:
#
#  1. "../peks.hpp"                  (was relative to ndn/ source dir)
#     → "peks.hpp"                   (all files now co-located in daemon/fw/)
#
#  2. <nfd/daemon/fw/strategy.hpp>   (installed-header path; not available during build)
#     → "strategy.hpp"               (relative, same directory as our file)
#
#  3. <nfd/daemon/fw/algorithm.hpp>  (same issue)
#     → "algorithm.hpp"
RUN sed -i \
        -e 's|"../peks\.hpp"|"peks.hpp"|g' \
        -e 's|<nfd/daemon/fw/strategy\.hpp>|"strategy.hpp"|g' \
        /opt/NFD/daemon/fw/peks_name.hpp \
        /opt/NFD/daemon/fw/peks_strategy.hpp \
    && sed -i \
        -e 's|<nfd/daemon/fw/algorithm\.hpp>|"algorithm.hpp"|g' \
        /opt/NFD/daemon/fw/peks_strategy.cpp

# Patch the NFD top-level wscript to link against mcl + gmp.
# ate_pairing.cpp uses libmcl; peks.cpp uses libgmp through mcl.
# We add the flags globally in build() so they propagate to the nfd binary link step.
RUN python3 - <<'EOF'
import pathlib, re

top = pathlib.Path('/opt/NFD/wscript')
text = top.read_text()

# In waf, library names must be added via lib= on the program target, not LINKFLAGS.
# Patch the bld.program call for 'nfd' to add mcl/gmp/gmpxx.
# Original line ends with: use='daemon-objects SYSTEMD')
patched = re.sub(
    r"(bld\.program\(name='nfd'.*?use='daemon-objects[^']*')\)",
    r"\1,\n                lib=['mcl', 'gmp', 'gmpxx'])",
    text,
    count=1,
    flags=re.DOTALL,
)

if patched == text:
    raise RuntimeError("Could not find bld.program(name='nfd',...) in NFD wscript")

top.write_text(patched)
print("NFD wscript patched: added lib=['mcl','gmp','gmpxx'] to bld.program('nfd')")
EOF

# Build NFD with the injected PeksStrategy
RUN cd /opt/NFD \
    && ./waf configure \
    && ./waf -j$(nproc) \
    && ./waf install \
    && ldconfig

COPY docker/scripts/start-router.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 6363/udp 6363/tcp

CMD ["/start.sh"]
